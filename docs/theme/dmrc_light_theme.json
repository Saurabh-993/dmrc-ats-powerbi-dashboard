{
  "name": "DMRC ATS — Daylight",
  "dataColors": [
    "#2563EB",
    "#94A3B8",
    "#0D9488",
    "#E0A106",
    "#DC2626",
    "#7C3AED",
    "#D97706",
    "#64748B"
  ],
  "foreground": "#0F172A",
  "foregroundNeutralSecondary": "#64748B",
  "foregroundNeutralTertiary": "#94A3B8",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6FA",
  "backgroundNeutral": "#E3E8F0",
  "tableAccent": "#0D9488",
  "good": "#059669",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "maximum": "#1D4ED8",
  "center": "#94A3B8",
  "minimum": "#E3E8F0",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Light",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#64748B"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8F0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "shadowSpread": 2,
            "shadowBlur": 6,
            "transparency": 92
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F6"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "wordWrap": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E8ECF3"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8F0"
              }
            },
            "radius": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8F0"
              }
            },
            "radius": 8
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "outline": "None"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "slices": [
          {
            "innerRadiusRatio": 62
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 9,
            "labelStyle": "Percent of total"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "RightCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF1F6"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#E3E8F0"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#334155"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#334155"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "outline": "TopOnly"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0,
            "$id": "default"
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "weight": 1,
            "radius": 8
          }
        ],
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "$id": "default"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "calloutValue": [
          {
            "properties": {
              "fontSize": 26,
              "fontFamily": "Segoe UI Light",
              "labelPrecision": 0,
              "fontColor": {
                "solid": {
                  "color": "#0F172A"
                }
              }
            }
          }
        ],
        "calloutValueLabel": [
          {
            "properties": {
              "fontSize": 26,
              "fontFamily": "Segoe UI Light",
              "fontColor": {
                "solid": {
                  "color": "#0F172A"
                }
              }
            }
          }
        ],
        "categoryLabel": [
          {
            "properties": {
              "show": true,
              "fontSize": 9,
              "fontFamily": "Segoe UI",
              "fontColor": {
                "solid": {
                  "color": "#64748B"
                }
              }
            }
          }
        ],
        "cardsBackground": [
          {
            "properties": {
              "show": true,
              "color": {
                "solid": {
                  "color": "#FFFFFF"
                }
              },
              "transparency": 0,
              "roundedCorners": 10
            }
          }
        ],
        "background": [
          {
            "properties": {
              "show": true,
              "color": {
                "solid": {
                  "color": "#FFFFFF"
                }
              },
              "transparency": 0
            }
          }
        ],
        "border": [
          {
            "properties": {
              "show": true,
              "color": {
                "solid": {
                  "color": "#E3E8F0"
                }
              },
              "radius": 10
            }
          }
        ],
        "visualHeader": [
          {
            "properties": {
              "show": false
            }
          }
        ]
      }
    }
  }
}