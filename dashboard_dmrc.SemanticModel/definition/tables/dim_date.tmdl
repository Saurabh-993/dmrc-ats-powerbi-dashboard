	partition dim_date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2024, 4, 28 ), DATE ( 2024, 8, 4 ) ),
				    "Year",      YEAR ( [Date] ),
				    "Month",     FORMAT ( [Date], "MMM" ),
				    "MonthNo",   MONTH ( [Date] ),
				    "DayName",   FORMAT ( [Date], "ddd" ),
				    "IsWeekend", WEEKDAY ( [Date], 2 ) > 5
				)

	annotation PBI_Id = 37150303080b4c56a64c57c195bceda0

